+#!/usr/bin/env python3
+from __future__ import annotations
+
+import argparse
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from run import parse_json_object
+
+
+DEFAULT_COMMAND = "/Library/Frameworks/Python.framework/Versions/3.11/bin/mlx_lm.generate"
+
+
+def format_patch_output(text: str) -> str:
+    return json.dumps(parse_json_object(text), separators=(",", ":"))
+
+
+def call_mlx_generate(
+    prompt: str,
+    model: str,
+    command: str,
+    timeout: int,
+    temperature: float,
+    max_tokens: int,
+) -> str:
+    args = [
+        command,
+        "--model",
+        model,
+        "--prompt",
+        prompt,
+        "--max-tokens",
+        str(max_tokens),
+        "--temp",
+        str(temperature),
+    ]
+    try:
+        completed = subprocess.run(
+            args,
+            text=True,
+            capture_output=True,
+            timeout=timeout,
+            check=False,
+        )
+    except subprocess.TimeoutExpired as exc:
+        raise RuntimeError(f"MLX command timed out after {exc.timeout} seconds") from exc
+    if completed.returncode != 0:
+        raise RuntimeError(
+            f"MLX command failed with exit code {completed.returncode}: {completed.stderr.strip()}"
+        )
+    if not completed.stdout.strip():
+        raise RuntimeError("MLX command produced no output")
+    return completed.stdout
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Call mlx_lm.generate for one Live Support State JSON patch.")
+    parser.add_argument("--model", required=True, help="MLX model id or local path.")
+    parser.add_argument("--command", default=DEFAULT_COMMAND, help="Path to mlx_lm.generate.")
+    parser.add_argument("--timeout", type=int, default=180)
+    parser.add_argument("--temperature", type=float, default=0.0)
+    parser.add_argument("--max-tokens", type=int, default=1200)
+    args = parser.parse_args()
+
+    prompt = sys.stdin.read()
+    try:
+        text = call_mlx_generate(
+            prompt=prompt,
+            model=args.model,
+            command=args.command,
+            timeout=args.timeout,
+            temperature=args.temperature,
+            max_tokens=args.max_tokens,
+        )
+        print(format_patch_output(text))
+    except Exception as exc:
+        print(f"mlx_patch_adapter: {exc}", file=sys.stderr)
+        raise SystemExit(1) from exc
+
+
+if __name__ == "__main__":
+    main()
