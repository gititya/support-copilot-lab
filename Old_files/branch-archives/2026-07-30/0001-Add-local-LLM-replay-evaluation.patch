+#!/usr/bin/env python3
+from __future__ import annotations
+
+import argparse
+import json
+import shlex
+import sys
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from common import OUTPUT_DIR, ensure_output_dir, load_fixtures, markdown_table
+from run import render_dashboard, render_report, run_fixture
+
+MODEL_REPLAY_DIR = OUTPUT_DIR / "model_replays"
+
+RECOMMENDED_MODELS = [
+    {"runtime": "ollama", "model": "gemma4:12b-it-qat"},
+    {"runtime": "ollama", "model": "qwen2.5:7b"},
+    {"runtime": "mlx", "model": "mlx-community/gemma-4-e4b-it-4bit"},
+    {"runtime": "mlx", "model": "mlx-community/Qwen3-4B-4bit"},
+]
+
+
+def slugify(value: str) -> str:
+    safe = []
+    for char in value.lower():
+        if char.isalnum():
+            safe.append(char)
+        elif char in {":", "/", ".", "-", "_"}:
+            safe.append("_")
+    return "_".join("".join(safe).split("_"))
+
+
+def adapter_command(runtime: str, model: str, timeout: int, max_output_tokens: int) -> str:
+    py = shlex.quote(sys.executable)
+    if runtime == "ollama":
+        adapter = ROOT / "prototype" / "ollama_patch_adapter.py"
+        return (
+            f"{py} {shlex.quote(str(adapter))} --model {shlex.quote(model)} "
+            f"--timeout {timeout} --num-predict {max_output_tokens}"
+        )
+    if runtime == "mlx":
+        adapter = ROOT / "prototype" / "mlx_patch_adapter.py"
+        return (
+            f"{py} {shlex.quote(str(adapter))} --model {shlex.quote(model)} "
+            f"--timeout {timeout} --max-tokens {max_output_tokens}"
+        )
+    raise ValueError(f"Unknown runtime: {runtime}")
+
+
+def parse_model_spec(spec: str) -> dict[str, str]:
+    runtime, sep, model = spec.partition(":")
+    if not sep or runtime not in {"ollama", "mlx"} or not model:
+        raise argparse.ArgumentTypeError("Model specs must look like ollama:gemma4:12b-it-qat or mlx:mlx-community/Qwen3-4B-4bit")
+    return {"runtime": runtime, "model": model}
+
+
+def select_fixtures(case_ids: list[str]) -> list[dict[str, Any]]:
+    fixtures = load_fixtures()
+    if not case_ids:
+        return fixtures
+    wanted = set(case_ids)
+    selected = [fixture for fixture in fixtures if fixture["case_id"] in wanted]
+    missing = sorted(wanted - {fixture["case_id"] for fixture in selected})
+    if missing:
+        available = ", ".join(fixture["case_id"] for fixture in fixtures)
+        raise SystemExit(f"Unknown case_id: {', '.join(missing)}. Available cases: {available}")
+    return selected
+
+
+def failed_result(fixture: dict[str, Any], error: Exception) -> dict[str, Any]:
+    message = " ".join(str(error).split())
+    if len(message) > 1200:
+        message = message[:1197] + "..."
+    return {
+        "fixture": fixture,
+        "timeline": [],
+        "final_state": {},
+        "root_cause_ok": False,
+        "mode": "llm",
+        "model_eval_status": "failed",
+        "model_eval_error": message,
+    }
+
+
+def run_model(
+    runtime: str,
+    model: str,
+    fixtures: list[dict[str, Any]],
+    timeout: int,
+    max_output_tokens: int,
+) -> list[dict[str, Any]]:
+    command = adapter_command(runtime, model, timeout, max_output_tokens)
+    results = []
+    for fixture in fixtures:
+        try:
+            result = run_fixture(fixture, mode="llm", llm_command=command, timeout=timeout)
+            result["model_eval_status"] = "completed"
+            result["model_eval_error"] = ""
+        except Exception as exc:
+            result = failed_result(fixture, exc)
+        result["model_runtime"] = runtime
+        result["model_name"] = model
+        results.append(result)
+    return results
+
+
+def summarize_results(results: list[dict[str, Any]]) -> dict[str, Any]:
+    checks = 0
+    passed = 0
+    premature = 0
+    next_checks = 0
+    next_passed = 0
+    expected_turns = 0
+    completed_turns = 0
+    failures = 0
+    field_misses: dict[str, int] = {}
+    field_extras: dict[str, int] = {}
+
+    for result in results:
+        expected_turns += len(result["fixture"].get("transcript_turns", []))
+        if result.get("model_eval_status") != "completed":
+            failures += 1
+            continue
+        completed_turns += len(result["timeline"])
+        for item in result["timeline"]:
+            verdict = item.get("verdict")
+            if not verdict:
+                continue
+            checks += verdict["total"]
+            passed += verdict["passed"]
+            for check in verdict["checks"]:
+                field = check["field"]
+                if field == "next_check":
+                    next_checks += 1
+                    if check["passed"]:
+                        next_passed += 1
+                if field == "final_cause_timing" and not check["passed"]:
+                    premature += 1
+                if check["missing"]:
+                    field_misses[field] = field_misses.get(field, 0) + len(check["missing"])
+                if check["extra"]:
+                    field_extras[field] = field_extras.get(field, 0) + len(check["extra"])
+
+    return {
+        "cases": len(results),
+        "fixture_failures": failures,
+        "expected_turns": expected_turns,
+        "completed_turns": completed_turns,
+        "valid_json_rate": round((completed_turns / expected_turns) * 100) if expected_turns else 0,
+        "checks": checks,
+        "passed": passed,
+        "pass_rate": round((passed / checks) * 100) if checks else 0,
+        "premature_final_cause_turns": premature,
+        "next_check_pass_rate": round((next_passed / next_checks) * 100) if next_checks else 0,
+        "field_misses": field_misses,
+        "field_extras": field_extras,
+    }
+
+
+def render_metric_dict(values: dict[str, int]) -> str:
+    if not values:
+        return "-"
+    return "; ".join(f"{key}: {value}" for key, value in sorted(values.items()))
+
+
+def render_model_eval_report(runtime: str, model: str, results: list[dict[str, Any]]) -> str:
+    summary = summarize_results(results)
+    rows = [[
+        summary["cases"],
+        summary["fixture_failures"],
+        f"{summary['completed_turns']}/{summary['expected_turns']}",
+        f"{summary['valid_json_rate']}%",
+        f"{summary['passed']}/{summary['checks']}",
+        f"{summary['pass_rate']}%",
+        summary["premature_final_cause_turns"],
+        f"{summary['next_check_pass_rate']}%",
+    ]]
+    lines = [
+        "# Local Model Replay Report",
+        "",
+        f"Runtime: `{runtime}`",
+        f"Model: `{model}`",
+        "",
+        markdown_table([
+            "cases",
+            "fixture_failures",
+            "completed_turns",
+            "valid_json_rate",
+            "checks",
+            "pass_rate",
+            "premature_final_cause_turns",
+            "next_check_pass_rate",
+        ], rows),
+        "",
+        "## Drift Summary",
+        "",
+        f"- Missing expected state items: {render_metric_dict(summary['field_misses'])}",
+        f"- Extra state items: {render_metric_dict(summary['field_extras'])}",
+        "",
+    ]
+
+    failures = [result for result in results if result.get("model_eval_status") != "completed"]
+    if failures:
+        lines.extend(["## Fixture Failures", ""])
+        for result in failures:
+            lines.append(f"- `{result['fixture']['case_id']}`: {result.get('model_eval_error', '-')}")
+        lines.append("")
+
+    completed = [result for result in results if result.get("model_eval_status") == "completed"]
+    if completed:
+        lines.append(render_report(completed, run_label=f"{runtime}:{model}"))
+    return "\n".join(lines)
+
+
+def write_model_outputs(runtime: str, model: str, results: list[dict[str, Any]]) -> dict[str, Path]:
+    MODEL_REPLAY_DIR.mkdir(parents=True, exist_ok=True)
+    stem = f"{runtime}_{slugify(model)}"
+    paths = {
+        "snapshots": MODEL_REPLAY_DIR / f"{stem}_snapshots.json",
+        "report": MODEL_REPLAY_DIR / f"{stem}_report.md",
+        "dashboard": MODEL_REPLAY_DIR / f"{stem}_dashboard.html",
+    }
+    paths["snapshots"].write_text(json.dumps(results, indent=2))
+    paths["report"].write_text(render_model_eval_report(runtime, model, results))
+    completed = [result for result in results if result.get("model_eval_status") == "completed"]
+    if completed:
+        paths["dashboard"].write_text(render_dashboard(completed, run_label=f"{runtime}:{model}"))
+    else:
+        paths["dashboard"].write_text("<!doctype html><title>Local Model Replay</title><p>No completed fixture runs.</p>")
+    return paths
+
+
+def render_summary(model_summaries: list[dict[str, Any]]) -> str:
+    rows = []
+    for item in model_summaries:
+        summary = item["summary"]
+        rows.append([
+            item["runtime"],
+            item["model"],
+            summary["cases"],
+            summary["fixture_failures"],
+            f"{summary['completed_turns']}/{summary['expected_turns']}",
+            f"{summary['valid_json_rate']}%",
+            f"{summary['passed']}/{summary['checks']}",
+            f"{summary['pass_rate']}%",
+            summary["premature_final_cause_turns"],
+            f"{summary['next_check_pass_rate']}%",
+        ])
+    return "\n".join([
+        "# Local Model Replay Summary",
+        "",
+        "Offline replay of local models over the same Live Support State fixture harness.",
+        "",
+        markdown_table([
+            "runtime",
+            "model",
+            "cases",
+            "fixture_failures",
+            "completed_turns",
+            "valid_json_rate",
+            "checks",
+            "pass_rate",
+            "premature_final_cause_turns",
+            "next_check_pass_rate",
+        ], rows),
+    ])
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Run offline local-model replays against Support Process Lab fixtures.")
+    parser.add_argument(
+        "--model",
+        action="append",
+        type=parse_model_spec,
+        default=[],
+        help="Runtime-prefixed model spec. Repeatable. Example: ollama:gemma4:12b-it-qat",
+    )
+    parser.add_argument("--case", action="append", default=[], help="Optional fixture case_id. Repeatable.")
+    parser.add_argument("--timeout", type=int, default=180)
+    parser.add_argument("--max-output-tokens", type=int, default=1200)
+    args = parser.parse_args()
+
+    ensure_output_dir()
+    fixtures = select_fixtures(args.case)
+    models = args.model or RECOMMENDED_MODELS
+    summaries = []
+
+    for spec in models:
+        runtime = spec["runtime"]
+        model = spec["model"]
+        print(f"Running {runtime}:{model}")
+        results = run_model(runtime, model, fixtures, args.timeout, args.max_output_tokens)
+        paths = write_model_outputs(runtime, model, results)
+        summary = summarize_results(results)
+        summaries.append({"runtime": runtime, "model": model, "summary": summary, "paths": paths})
+        print(f"Wrote {paths['snapshots']}")
+        print(f"Wrote {paths['report']}")
+        print(f"Wrote {paths['dashboard']}")
+
+    summary_path = MODEL_REPLAY_DIR / "summary.md"
+    summary_path.write_text(render_summary(summaries))
+    print(f"Wrote {summary_path}")
+
+
+if __name__ == "__main__":
+    main()
