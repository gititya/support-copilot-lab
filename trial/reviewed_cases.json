[
  {
    "id": "C01",
    "family": "access",
    "split": "development",
    "title": "Migration access review",
    "sources": [
      {
        "id": "identity",
        "description": "Read sign-in status for affected users"
      },
      {
        "id": "workspace_access",
        "description": "Read workspace permissions for affected users"
      },
      {
        "id": "migration_audit",
        "description": "Read the migration access-change record"
      }
    ],
    "questions": [
      {
        "id": "scope",
        "text": "Which users are affected?"
      },
      {
        "id": "login",
        "text": "Can the affected users sign in?"
      },
      {
        "id": "impact",
        "text": "What action is blocked?"
      },
      {
        "id": "comparison",
        "text": "Who has actually tried the same activity, and who succeeded?"
      },
      {
        "id": "post_change",
        "text": "Did that same activity work after the migration, and for whom?"
      },
      {
        "id": "authority",
        "text": "Should these users have access, and who is permitted and able to grant it?"
      }
    ],
    "stages": [
      {
        "event": {
          "text": "A workspace admin reports that two members lost access after the weekend migration.",
          "facts": {
            "reported_scope": "two workspace members",
            "reported_login": "access lost after migration",
            "migration_window": "weekend"
          }
        },
        "reads": {
          "identity": {
            "status": "ok",
            "text": "The identity service has a status record for the two reported members; the record does not identify an access cause.",
            "facts": {
              "login_status": "status record available"
            }
          }
        },
        "answers": {
          "scope": {
            "text": "The report names two workspace members.",
            "facts": {
              "reported_scope": "two workspace members"
            }
          },
          "impact": {
            "text": "The report only says access was lost.",
            "facts": {
              "reported_impact": "workspace access unavailable"
            }
          }
        },
        "expected": {
          "kinds": [
            "ask",
            "wait"
          ],
          "cause": null,
          "evidence": {},
          "required_facts": [
            "reported_scope",
            "reported_login"
          ],
          "avoid_questions": [],
          "useful_reads": [
            "identity"
          ],
          "useful_questions": [
            "scope",
            "login",
            "impact"
          ]
        }
      },
      {
        "event": {
          "text": "Both members can now sign in, but each is still blocked from opening the migrated workspace.",
          "facts": {
            "reported_scope": "two workspace members",
            "reported_login": "sign-in succeeds",
            "reported_impact": "migrated workspace cannot be opened"
          }
        },
        "reads": {
          "identity": {
            "status": "ok",
            "text": "The identity service reports successful sign-in for both affected users.",
            "facts": {
              "login_status": "both users authenticated"
            }
          },
          "workspace_access": {
            "status": "ok",
            "text": "The access record shows no workspace permission and an access-denied observation for either affected user.",
            "facts": {
              "workspace_permission": "missing",
              "access_denied": "workspace open denied"
            }
          }
        },
        "answers": {
          "login": {
            "text": "Both affected users can sign in.",
            "facts": {
              "reported_login": "sign-in succeeds"
            }
          },
          "impact": {
            "text": "They report that they cannot open the migrated workspace.",
            "facts": {
              "reported_impact": "migrated workspace cannot be opened"
            }
          }
        },
        "expected": {
          "kinds": [
            "suggest_fix"
          ],
          "cause": "missing_permission",
          "evidence": {
            "workspace_permission": "missing",
            "access_denied": "workspace open denied"
          },
          "required_facts": [
            "reported_scope",
            "reported_login",
            "workspace_permission",
            "access_denied"
          ],
          "avoid_questions": [],
          "useful_reads": [
            "identity",
            "workspace_access"
          ],
          "useful_questions": [
            "scope",
            "login",
            "impact"
          ]
        }
      }
    ],
    "review_status": "post_evaluation_regression_not_unseen"
  },
  {
    "id": "C02",
    "family": "integration",
    "split": "development",
    "title": "Connector sync review",
    "sources": [
      {
        "id": "integration_health",
        "description": "Read the connector health and recent run state"
      },
      {
        "id": "credential",
        "description": "Read the connector credential metadata"
      },
      {
        "id": "usage_limits",
        "description": "Read the connector service usage record"
      }
    ],
    "questions": [
      {
        "id": "scope",
        "text": "Which records or users are affected?"
      },
      {
        "id": "last_success",
        "text": "When did the connector last succeed?"
      },
      {
        "id": "impact",
        "text": "What integration action failed?"
      },
      {
        "id": "nature",
        "text": "Are whole records missing, incomplete, or still delayed?"
      },
      {
        "id": "pattern",
        "text": "What types, examples and date or time range are affected?"
      },
      {
        "id": "comparison",
        "text": "Which comparable records arrived successfully?"
      },
      {
        "id": "processing",
        "text": "Is processing finished, and how long have these records remained absent?"
      },
      {
        "id": "change_check",
        "text": "What evidence shows whether the scheduled change affected this transfer?"
      }
    ],
    "stages": [
      {
        "event": {
          "text": "A representative reports that the directory connector stopped syncing a team after its configuration change.",
          "facts": {
            "reported_scope": "one team directory",
            "reported_sync": "sync stopped after configuration change",
            "reported_impact": "directory records not updating"
          }
        },
        "reads": {
          "integration_health": {
            "status": "ok",
            "text": "The connector health record confirms a failed run for the reported team; it does not identify a cause.",
            "facts": {
              "run_status": "failed"
            }
          }
        },
        "answers": {
          "scope": {
            "text": "The report names one team directory.",
            "facts": {
              "reported_scope": "one team directory"
            }
          },
          "impact": {
            "text": "Directory records are not updating.",
            "facts": {
              "reported_impact": "directory records not updating"
            }
          }
        },
        "expected": {
          "kinds": [
            "ask",
            "wait"
          ],
          "cause": null,
          "evidence": {},
          "required_facts": [
            "reported_scope",
            "reported_sync",
            "run_status"
          ],
          "avoid_questions": [],
          "useful_reads": [
            "integration_health"
          ],
          "useful_questions": [
            "scope",
            "last_success",
            "impact"
          ]
        }
      },
      {
        "event": {
          "text": "The representative confirms that retries are failing for the same team and asks for the next safe step.",
          "facts": {
            "reported_scope": "one team directory",
            "reported_sync": "retries fail",
            "reported_impact": "directory records not updating"
          }
        },
        "reads": {
          "credential": {
            "status": "ok",
            "text": "For this connector and account, the failed request has a rejected signature and the credential does not match the current integration configuration.",
            "facts": {
              "auth_error": "request signature rejected",
              "credential_match": "mismatch",
              "credential_version": "outdated"
            }
          }
        },
        "answers": {
          "last_success": {
            "text": "The health record shows recent runs failing; no exact success time is available in this read.",
            "facts": {
              "last_success": "not available in health read"
            }
          },
          "impact": {
            "text": "The representative reports that the connector cannot update directory records.",
            "facts": {
              "reported_impact": "directory records not updating"
            }
          }
        },
        "expected": {
          "kinds": [
            "suggest_fix"
          ],
          "cause": "credential_mismatch",
          "evidence": {
            "auth_error": "request signature rejected",
            "credential_match": "mismatch"
          },
          "required_facts": [
            "reported_scope",
            "reported_impact",
            "auth_error",
            "credential_match"
          ],
          "avoid_questions": [],
          "useful_reads": [
            "credential"
          ],
          "useful_questions": [
            "scope",
            "last_success",
            "impact"
          ]
        }
      }
    ],
    "review_status": "post_evaluation_regression_not_unseen"
  },
